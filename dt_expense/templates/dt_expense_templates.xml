<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_expense_home" name="Expense Home">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page dt-expense-home pb-4">

                <form action="/my/apps/expenses/balance/save" method="post" class="dt-panel d-none" data-balance-form="1">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label class="dt-field">
                        <span>Cập nhật số dư nguồn tiền</span>
                        <select name="wallet_id">
                            <t t-foreach="wallets" t-as="wallet">
                                <option t-att-value="wallet.id"><t t-esc="wallet.icon or '💳'"/> <t t-esc="wallet.name"/> · <t t-esc="wallet.balance_label"/></option>
                            </t>
                        </select>
                    </label>
                    <label class="dt-field">
                        <span>Số dư thực tế</span>
                        <input type="text" name="current_amount" t-att-value="current_balance_input" data-money-input="1" data-money-suggestions="10000,50000,100000,500000"/>
                    </label>
                    <div class="dt-inline-actions">
                        <button type="submit" class="dt-btn dt-btn--primary">Lưu cập nhật</button>
                        <button type="button" class="dt-btn dt-btn--ghost" data-balance-cancel="1">Hủy</button>
                    </div>
                </form>

                <div class="dt-shortcut-panel">
                    <a href="/my/apps/expenses/new" class="dt-shortcut"><span>✍️</span><strong>Nhập GD</strong></a>
                    <a href="/my/apps/expenses/reports" class="dt-shortcut"><span>📊</span><strong>Biến động</strong></a>
                    <a href="/my/apps/expenses/debts" class="dt-shortcut"><span>🤝</span><strong>Sổ nợ</strong></a>
                    <a href="/my/apps/expenses/wallets" class="dt-shortcut"><span>💳</span><strong>Nguồn tiền</strong></a>
                </div>

                <div class="dt-card-grid-2">
                    <a href="/my/apps/expenses/reports?period=month" class="dt-stat-tile">
                        <div class="dt-stat-tile__label"><span class="dt-dot dt-dot--income">↓</span> Thu <t t-esc="month_short_label"/></div>
                        <strong><t t-esc="month_income_label"/></strong>
                    </a>
                    <a href="/my/apps/expenses/reports?period=month" class="dt-stat-tile">
                        <div class="dt-stat-tile__label"><span class="dt-dot dt-dot--expense">↑</span> Chi <t t-esc="month_short_label"/></div>
                        <strong><t t-esc="month_expense_label"/></strong>
                    </a>
                </div>

                <div class="dt-family-card" t-if="member_rows">
                    <div class="dt-row-between mb-2"><h2>Cả nhà tháng này</h2><a href="/my/apps/expenses/history?scope=family">Xem chi tiết</a></div>
                    <div class="dt-member-strip">
                        <t t-foreach="member_rows" t-as="row">
                            <div class="dt-member-mini">
                                <img t-attf-src="/web/image/res.partner/#{row['user'].partner_id.id}/avatar_128"/>
                                <strong><t t-esc="row['user'].name.split(' ')[-1] if row['user'].name else 'Bạn'"/></strong>
                                <small><t t-esc="row['expense_label']"/></small>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="dt-report-card">
                    <div class="dt-row-between mb-3">
                        <h2>Báo cáo chi tiêu</h2>
                        <a href="/my/apps/expenses/reports">Xem tất cả →</a>
                    </div>
                    <div class="dt-report-preview">
                        <div class="dt-donut" t-att-style="report['pie_style']"><span><strong><t t-esc="report['total_label']"/></strong><small>Tổng chi</small></span></div>
                        <div class="dt-report-lines">
                            <t t-if="report['rows']">
                                <t t-foreach="report['rows']" t-as="row">
                                    <div class="dt-report-line">
                                        <div><span><t t-esc="row['icon']"/></span> <t t-esc="row['name']"/></div>
                                        <strong><t t-esc="row['ratio']"/>%</strong>
                                        <div class="dt-bar"><i t-att-style="'width:' + str(row['ratio_raw']) + '%;background:' + str(row['color']) + ';'"></i></div>
                                    </div>
                                </t>
                            </t>
                            <t t-else=""><div class="dt-empty-state">Chưa có chi tiêu trong tháng này.</div></t>
                        </div>
                    </div>
                </div>

                <div class="dt-card-grid-2">
                    <a href="/my/apps/expenses/debts?state=open" class="dt-debt-tile"><span>↗ Cho mượn</span><strong><t t-esc="debt_lend_label"/></strong></a>
                    <a href="/my/apps/expenses/debts?state=open" class="dt-debt-tile"><span>↙ Đi mượn</span><strong><t t-esc="debt_borrow_label"/></strong></a>
                </div>
    
                <a href="/my/apps/expenses/new" class="dt-fab dt-fab--center d-none" aria-label="Tạo giao dịch">+</a>
            </section>
        </t>
    </template>

    <template id="portal_expense_form" name="Expense Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <form action="/my/apps/expenses/save" method="post" enctype="multipart/form-data" class="dt-form-stack" data-expense-form="1">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="entry" type="hidden" name="entry_id" t-att-value="entry.id"/>
                    <input type="hidden" name="entry_type" t-att-value="active_tab" data-entry-type-hidden="1"/>

                    <div class="dt-segment" data-entry-tabbar="1">
                        <button type="button" t-attf-class="#{'is-active' if active_tab == 'expense' else ''}" data-entry-tab="expense">Chi tiêu</button>
                        <button type="button" t-attf-class="#{'is-active' if active_tab == 'income' else ''}" data-entry-tab="income">Thu nhập</button>
                        <!-- <button type="button" t-attf-class="#{'is-active' if active_tab == 'adjustment' else ''}" data-entry-tab="adjustment">Điều chỉnh</button> -->
                    </div>

                    <div class="dt-quick-cats" data-category-field="1">
                        <div class="dt-block-title">Danh mục</div>
                        <div class="dt-quick-cats__row">
                            <t t-foreach="quick_categories" t-as="cat">
                                <button type="button" t-attf-class="dt-quick-cat #{'is-active' if entry and entry.category_id.id == cat.id else ''}" t-att-data-category-id="cat.id" t-att-data-entry-type="cat.category_type" t-att-data-next-month-rule="'1' if cat.apply_next_month_rule else '0'">
                                    <span><t t-esc="cat.icon or '💸'"/></span><small><t t-esc="cat.name"/></small>
                                </button>
                            </t>
                            <button type="button" class="dt-quick-cat" data-show-all-categories="1"><span>+</span><small>Thêm</small></button>
                        </div>
                    </div>

                    <select name="category_id" class="dt-hidden-select" data-category-select="1" data-category-field="1">
                        <option value="">Chọn danh mục</option>
                        <t t-foreach="categories" t-as="cat">
                            <option t-att-value="cat.id" t-att-data-entry-type="cat.category_type" t-att-data-next-month-rule="'1' if cat.apply_next_month_rule else '0'" t-att-selected="'selected' if entry and entry.category_id and entry.category_id.id == cat.id else None"><t t-esc="cat.icon or '💸'"/> <t t-esc="cat.name"/></option>
                        </t>
                    </select>

                    <div class="dt-all-categories d-none" data-all-categories="1">
                        <div class="dt-row-between mb-2"><strong>Tất cả danh mục</strong><button type="button" data-hide-all-categories="1">Đóng</button></div>
                        <div class="dt-all-categories__grid">
                            <t t-foreach="categories" t-as="cat">
                                <button type="button" t-attf-class="dt-all-cat #{'is-active' if entry and entry.category_id.id == cat.id else ''}" t-att-data-category-id="cat.id" t-att-data-entry-type="cat.category_type" t-att-data-next-month-rule="'1' if cat.apply_next_month_rule else '0'">
                                    <span><t t-esc="cat.icon or '💸'"/></span><small><t t-esc="cat.display_name"/></small>
                                </button>
                            </t>
                            <a t-att-href="'/my/apps/expenses/categories/new?category_type=%s' % active_tab" class="dt-all-cat dt-all-cat--add"><span>＋</span><small>Tạo mới</small></a>
                        </div>
                    </div>

                    <div class="dt-amount-panel">
                        <span>Số tiền</span>
                        <input type="text" name="amount" t-att-value="amount_input_value" placeholder="0" data-money-input="1" data-money-suggestions="10000,50000,100000,500000"/>
                    </div>

                    <div class="dt-info-panel">
                        <label class="dt-line-field">
                            <span>✏️ Mô tả</span>
                            <input type="text" name="name" t-att-value="entry.name if entry else ''" placeholder="Ví dụ: Đi siêu thị Coopmart" data-title-input="1" autocomplete="off"/>
                            <div class="dt-autocomplete-list d-none" data-title-suggestion-list="1"></div>
                        </label>
                        <label class="dt-line-field">
                            <span>📅 Ngày</span>
                            <input type="date" name="expense_date" t-att-value="default_date" data-expense-date="1"/>
                        </label>
                        <label class="dt-line-field d-none">
                            <span>Tháng hạch toán</span>
                            <input type="date" name="accounting_month" t-att-value="default_accounting_month" data-accounting-month="1"/>
                        </label>
                        <label class="dt-line-field">
                            <span>💳 Nguồn tiền</span>
                            <select name="wallet_id">
                                <t t-foreach="wallets" t-as="wallet">
                                    <option t-att-value="wallet.id" t-att-selected="'selected' if default_wallet and default_wallet.id == wallet.id else None"><t t-esc="wallet.icon or '💳'"/> <t t-esc="wallet.name"/></option>
                                </t>
                            </select>
                        </label>
                        <div class="dt-line-field" data-adjustment-only="1">
                            <span>↔️ Điều chỉnh</span>
                            <div class="dt-radio-line">
                                <label><input type="radio" name="adjustment_direction" value="increase" t-att-checked="'checked' if not entry or entry.adjustment_direction == 'increase' else None"/> Tăng</label>
                                <label><input type="radio" name="adjustment_direction" value="decrease" t-att-checked="'checked' if entry and entry.adjustment_direction == 'decrease' else None"/> Giảm</label>
                            </div>
                        </div>
                        <label class="dt-line-field">
                            <span>📝 Ghi chú</span>
                            <textarea name="note" rows="2" placeholder="Thêm ghi chú nếu cần"><t t-esc="entry.note if entry else ''"/></textarea>
                        </label>
                        <label class="dt-line-field">
                            <span>🧾 Ảnh</span>
                            <input class="dt-file-input" type="file" name="media_files" accept="image/*,video/*" multiple="multiple" data-file-input="1"/><span class="dt-file-button">Tải file</span>
                        </label>
                    </div>

                    <div class="dt-media-grid" t-if="media_items">
                        <t t-foreach="media_items" t-as="media">
                            <div class="dt-media-tile">
                                <img t-if="media.media_type == 'image'" t-att-src="media.image_url()"/>
                                <video t-if="media.media_type == 'video'" t-att-src="media.stream_url()" controls="controls" preload="metadata"></video>
                            </div>
                        </t>
                    </div>

                    <div class="dt-save-bar">
                        <button type="submit" class="dt-btn dt-btn--primary"> <t t-esc="'Lưu giao dịch' if entry else 'Thêm giao dịch'"/> · <span data-save-amount-preview="1"></span></button>
                    </div>
                </form>
            </section>
        </t>
    </template>

    <template id="portal_expense_view" name="Expense View">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <div class="dt-panel dt-form-stack">
                    <div class="dt-amount-panel"><span>Số tiền</span><strong t-attf-class="#{entry.amount_css_class}"><t t-esc="entry.amount_label"/></strong></div>
                    <div class="dt-info-panel">
                        <div class="dt-line-field dt-readonly-line"><span>✏️ Mô tả</span><strong><t t-esc="entry.name"/></strong></div>
                        <div class="dt-line-field dt-readonly-line"><span>🗂️ Danh mục</span><strong><t t-esc="entry.category_id.display_name if entry.category_id else entry.get_entry_type_label()"/></strong></div>
                        <div class="dt-line-field dt-readonly-line"><span>📅 Ngày</span><strong><t t-esc="entry.expense_date.strftime('%d/%m/%Y') if entry.expense_date else ''"/></strong></div>
                        <div class="dt-line-field dt-readonly-line"><span>👤 Người chi</span><strong><img t-attf-src="/web/image/res.partner/#{entry.user_id.partner_id.id}/avatar_128"/> <t t-esc="entry.user_id.name"/></strong></div>
                        <div class="dt-line-field dt-readonly-line"><span>💳 Nguồn tiền</span><strong><t t-esc="entry.wallet_id.display_name if entry.wallet_id else ''"/></strong></div>
                        <div class="dt-line-field dt-readonly-line" t-if="entry.note"><span>📝 Ghi chú</span><strong><t t-esc="entry.note"/></strong></div>
                    </div>
                    <div class="dt-media-grid dt-media-grid--large" t-if="media_items">
                        <t t-foreach="media_items" t-as="media">
                            <div class="dt-media-tile"><img t-if="media.media_type == 'image'" t-att-src="media.image_url()"/><video t-if="media.media_type == 'video'" t-att-src="media.stream_url()" controls="controls" preload="metadata"></video></div>
                        </t>
                    </div>
                    <div class="dt-inline-actions" t-if="can_edit"><a t-att-href="'/my/apps/expenses/%s/edit' % entry.id" class="dt-btn dt-btn--primary">Sửa</a><form t-att-action="'/my/apps/expenses/%s/delete' % entry.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="dt-btn dt-btn--ghost">Xóa</button></form></div>
                    <div class="dt-empty-state" t-if="not can_edit and scope == 'family'">Chế độ xem gia đình chỉ đọc.</div>
                </div>
            </section>
        </t>
    </template>

    <template id="portal_expense_categories" name="Expense Categories">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <div class="dt-screen-head dt-row-between">
                    <div><h1><t t-esc="page_title"/></h1><p><t t-esc="page_subtitle"/></p></div>
                    <a t-att-href="'/my/apps/expenses/categories/new?category_type=%s' % category_type" class="dt-round-btn dt-round-btn--green">+</a>
                </div>
                <div class="dt-chip-tabs">
                    <a t-attf-class="#{'is-active' if category_type == 'expense' else ''}" href="/my/apps/expenses/categories?category_type=expense">Chi tiêu</a>
                    <a t-attf-class="#{'is-active' if category_type == 'income' else ''}" href="/my/apps/expenses/categories?category_type=income">Thu nhập</a>
                </div>
                <t t-if="roots">
                    <t t-foreach="roots" t-as="root">
                        <div class="dt-category-card">
                            <div class="dt-category-card__head">
                                <div class="dt-category-icon"><t t-esc="root.icon or '💸'"/></div>
                                <div><h2><t t-esc="root.name"/></h2><p><t t-esc="len(root.child_ids.filtered('active'))"/> mục con · <t t-esc="root.entry_count"/> giao dịch trực tiếp</p></div>
                                <a t-att-href="'/my/apps/expenses/categories/%s/edit' % root.id" class="dt-more-btn">…</a>
                            </div>
                            <div class="dt-child-grid">
                                <t t-foreach="root.child_ids.filtered('active')" t-as="child">
                                    <a t-att-href="'/my/apps/expenses/categories/%s/edit' % child.id" class="dt-child-cat"><span><t t-esc="child.icon or root.icon or '💸'"/></span><strong><t t-esc="child.name"/></strong><small><t t-esc="child.entry_count"/> lần</small></a>
                                </t>
                                <a t-att-href="'/my/apps/expenses/categories/new?category_type=%s&amp;parent_id=%s' % (category_type, root.id)" class="dt-child-cat dt-child-cat--add"><span>＋</span><strong>Thêm</strong></a>
                            </div>
                        </div>
                    </t>
                </t>
                <t t-else=""><div class="dt-empty-state">Chưa có danh mục.</div></t>
            </section>
        </t>
    </template>

    <template id="portal_expense_category_form" name="Expense Category Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <form action="/my/apps/expenses/categories/save" method="post" class="dt-panel dt-form-stack">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="category" type="hidden" name="category_id" t-att-value="category.id"/>
                    <label class="dt-field"><span>Tên</span><input type="text" name="name" t-att-value="category.name if category else ''" required="required"/></label>
                    <div class="dt-grid-2">
                        <label class="dt-field"><span>Icon</span><input type="text" name="icon" t-att-value="category.icon if category else '💸'"/></label>
                        <label class="dt-field"><span>Thứ tự</span><input type="number" name="sequence" t-att-value="category.sequence if category else 10"/></label>
                    </div>
                    <label class="dt-field"><span>Loại</span><select name="category_type"><option value="expense" t-att-selected="'selected' if category_type == 'expense' else None">Chi tiêu</option><option value="income" t-att-selected="'selected' if category_type == 'income' else None">Thu nhập</option></select></label>
                    <label class="dt-field"><span>Danh mục cha</span><select name="parent_id"><option value="">Không có</option><t t-foreach="parents" t-as="parent"><option t-att-value="parent.id" t-att-selected="'selected' if selected_parent and selected_parent.id == parent.id else None"><t t-esc="parent.icon"/> <t t-esc="parent.name"/></option></t></select></label>
                    <label class="dt-check-line"><input type="checkbox" name="apply_next_month_rule" t-att-checked="'checked' if category and category.apply_next_month_rule else None"/> Cuối tháng tính sang tháng sau</label>
                    <label class="dt-field"><span>Ghi chú</span><textarea name="note" rows="3"><t t-esc="category.note if category else ''"/></textarea></label>
                    <button class="dt-btn dt-btn--primary" type="submit">Lưu danh mục</button>
                </form>
            </section>
        </t>
    </template>

    <template id="portal_expense_wallets" name="Expense Wallets">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <div class="dt-screen-head dt-row-between"><div><h1>Nguồn tiền</h1><p>Momo, ngân hàng, tiền mặt của bạn</p></div><a href="/my/apps/expenses/wallets/new" class="dt-round-btn dt-round-btn--green">+</a></div>
                <div class="dt-list-stack">
                    <t t-foreach="wallets" t-as="wallet">
                        <div class="dt-wallet-card">
                            <div><span class="dt-category-icon"><t t-esc="wallet.icon or '💳'"/></span></div>
                            <div><h2><t t-esc="wallet.name"/></h2><p><t t-esc="wallet.entry_count"/> giao dịch</p></div>
                            <div class="dt-wallet-card__right"><strong><t t-esc="wallet.balance_label"/></strong><a t-att-href="'/my/apps/expenses/wallets/%s/edit' % wallet.id">Sửa</a></div>
                        </div>
                    </t>
                </div>
            </section>
        </t>
    </template>

    <template id="portal_expense_wallet_form" name="Expense Wallet Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <form action="/my/apps/expenses/wallets/save" method="post" class="dt-panel dt-form-stack">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="wallet" type="hidden" name="wallet_id" t-att-value="wallet.id"/>
                    <label class="dt-field"><span>Tên nguồn tiền</span><input type="text" name="name" t-att-value="wallet.name if wallet else ''" required="required"/></label>
                    <div class="dt-grid-2"><label class="dt-field"><span>Icon</span><input type="text" name="icon" t-att-value="wallet.icon if wallet else '💳'"/></label><label class="dt-field"><span>Thứ tự</span><input type="number" name="sequence" t-att-value="wallet.sequence if wallet else 10"/></label></div>
                    <label class="dt-field"><span>Số dư đầu kỳ</span><input type="text" name="opening_balance" t-att-value="request.env['dt.expense.entry'].format_amount_for_input(wallet.opening_balance) if wallet else '0'" data-money-input="1"/></label>
                    <label class="dt-field"><span>Ghi chú</span><textarea name="note" rows="3"><t t-esc="wallet.note if wallet else ''"/></textarea></label>
                    <button class="dt-btn dt-btn--primary" type="submit">Lưu nguồn tiền</button>
                </form>
            </section>
        </t>
    </template>

    <template id="portal_expense_debts" name="Expense Debts">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <div class="dt-screen-head dt-row-between"><div><h1>Sổ nợ</h1><p>Cho vay và đi vay người khác</p></div><a href="/my/apps/expenses/debts/new" class="dt-round-btn dt-round-btn--green">+</a></div>
                <div class="dt-card-grid-2"><div class="dt-debt-tile"><span>Cho vay</span><strong><t t-esc="lend_total_label"/></strong></div><div class="dt-debt-tile"><span>Đang nợ</span><strong><t t-esc="borrow_total_label"/></strong></div></div>
                <div class="dt-chip-tabs"><a t-attf-class="#{'is-active' if state == 'open' else ''}" href="/my/apps/expenses/debts?state=open">Đang mở</a><a t-attf-class="#{'is-active' if state == 'paid' else ''}" href="/my/apps/expenses/debts?state=paid">Đã trả</a><a t-attf-class="#{'is-active' if state == 'all' else ''}" href="/my/apps/expenses/debts?state=all">Tất cả</a></div>
                <div class="dt-list-stack">
                    <t t-if="debts">
                        <t t-foreach="debts" t-as="debt">
                            <div class="dt-debt-card">
                                <div class="dt-row-between"><h2><t t-esc="'Cho mượn' if debt.debt_type == 'lend' else 'Đi mượn'"/> · <t t-esc="debt.counterparty"/></h2><strong><t t-esc="debt.remaining_amount and request.env['dt.expense.entry']._format_money(debt.remaining_amount) or '0đ'"/></strong></div>
                                <p><t t-esc="debt.debt_date.strftime('%d/%m/%Y') if debt.debt_date else ''"/> · Gốc <t t-esc="request.env['dt.expense.entry']._format_money(debt.amount)"/> · Đã trả <t t-esc="request.env['dt.expense.entry']._format_money(debt.paid_amount)"/></p>
                                <div class="dt-progress"><i t-att-style="'width:' + str(0 if not debt.amount else (debt.paid_amount / debt.amount) * 100) + '%;'"></i></div>
                                <form t-if="debt.state == 'open'" t-att-action="'/my/apps/expenses/debts/%s/payment' % debt.id" method="post" class="dt-mini-payment">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="text" name="payment_amount" t-att-value="request.env['dt.expense.entry'].format_amount_for_input(debt.remaining_amount)" data-money-input="1"/>
                                    <input type="date" name="payment_date"/>
                                    <button type="submit">Ghi nhận</button>
                                </form>
                                <div class="dt-inline-actions mt-2"><a t-att-href="'/my/apps/expenses/debts/%s/edit' % debt.id" class="dt-btn dt-btn--ghost">Sửa</a></div>
                            </div>
                        </t>
                    </t>
                    <t t-else=""><div class="dt-empty-state">Chưa có khoản nợ nào.</div></t>
                </div>
            </section>
        </t>
    </template>

    <template id="portal_expense_debt_form" name="Expense Debt Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <form action="/my/apps/expenses/debts/save" method="post" class="dt-panel dt-form-stack">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="debt" type="hidden" name="debt_id" t-att-value="debt.id"/>
                    <div class="dt-segment"><label t-attf-class="#{'is-active' if debt_type == 'lend' else ''}"><input type="radio" name="debt_type" value="lend" t-att-checked="'checked' if debt_type == 'lend' else None"/> Cho mượn</label><label t-attf-class="#{'is-active' if debt_type == 'borrow' else ''}"><input type="radio" name="debt_type" value="borrow" t-att-checked="'checked' if debt_type == 'borrow' else None"/> Mình mượn</label></div>
                    <label class="dt-field"><span>Người liên quan</span><input type="text" name="counterparty" t-att-value="debt.counterparty if debt else ''" required="required"/></label>
                    <label class="dt-field"><span>Số tiền</span><input type="text" name="amount" t-att-value="request.env['dt.expense.entry'].format_amount_for_input(debt.amount) if debt else ''" data-money-input="1" required="required"/></label>
                    <label class="dt-field"><span>Nguồn tiền</span><select name="wallet_id"><t t-foreach="wallets" t-as="wallet"><option t-att-value="wallet.id" t-att-selected="'selected' if debt and debt.wallet_id.id == wallet.id else None"><t t-esc="wallet.icon"/> <t t-esc="wallet.name"/></option></t></select></label>
                    <div class="dt-grid-2"><label class="dt-field"><span>Ngày phát sinh</span><input type="date" name="debt_date" t-att-value="debt.debt_date.isoformat() if debt else default_date"/></label><label class="dt-field"><span>Hạn trả</span><input type="date" name="due_date" t-att-value="debt.due_date.isoformat() if debt and debt.due_date else ''"/></label></div>
                    <label class="dt-field"><span>Tiêu đề/ghi chú ngắn</span><input type="text" name="name" t-att-value="debt.name if debt else ''"/></label>
                    <label class="dt-field"><span>Ghi chú</span><textarea name="note" rows="3"><t t-esc="debt.note if debt else ''"/></textarea></label>
                    <button class="dt-btn dt-btn--primary" type="submit">Lưu khoản nợ</button>
                </form>
            </section>
        </t>
    </template>

    <template id="portal_expense_history_entries_partial" name="Expense History Entries Partial">
        <t t-foreach="entries" t-as="entry">
            <div class="dt-history-row">
                <div class="dt-history-icon dt-history-icon--media">
                    <t t-if="entry.cover_media_id and entry.cover_media_id.media_type == 'image'"><img t-att-src="entry.cover_media_id.image_url()"/></t>
                    <t t-elif="entry.cover_media_id and entry.cover_media_id.media_type == 'video'"><video t-att-src="entry.cover_media_id.stream_url()" preload="metadata" muted="muted" playsinline="playsinline"></video></t>
                    <t t-else=""><t t-esc="entry.get_icon()"/></t>
                </div>
                <div class="dt-history-main">
                    <h3><a t-att-href="'/my/apps/expenses/%s/view?scope=%s' % (entry.id, scope)"><t t-esc="entry.name or (entry.category_id.name if entry.category_id else (entry.get_debt_flow_label() if entry.entry_type == 'debt' else entry.get_entry_type_label()))"/></a></h3>
                    <p><span t-if="entry.category_id"><t t-esc="entry.category_id.name"/> · </span><span t-if="entry.entry_type == 'debt'"><t t-esc="entry.get_debt_flow_label()"/> · </span><t t-esc="entry.user_id.name"/> · <t t-esc="entry.wallet_id.name if entry.wallet_id else ''"/></p>
                </div>
                <div t-attf-class="dt-history-amount #{entry.amount_css_class}"><t t-esc="entry.amount_label"/></div>
                <div class="dt-history-actions" t-if="(scope) == 'mine' and entry.user_id.id == request.env.user.id and entry.entry_type != 'debt'">
                    <a t-att-href="'/my/apps/expenses/%s/edit' % entry.id">Sửa</a>
                    <form t-att-action="'/my/apps/expenses/%s/delete' % entry.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit">Xóa</button></form>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_expense_history" name="Expense History">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <div class="dt-screen-head"><h1>Lịch sử giao dịch</h1><p><t t-esc="month_label"/> · <t t-esc="len(entries)"/> giao dịch</p></div>
                <div class="dt-month-card" data-month-nav="1" t-att-data-date-from="date_from"><a href="#" data-month-nav-dir="-1">‹</a><div><strong>📅 <t t-esc="month_label"/></strong><div class="dt-month-totals"><span>Thu <b class="dt-amount-positive"><t t-esc="total_income_label"/></b></span><span>Chi <b class="dt-amount-negative"><t t-esc="total_expense_label"/></b></span><span>Ròng <b><t t-esc="total_net_label"/></b></span></div></div><a href="#" data-month-nav-dir="1">›</a></div>
                <form method="get" action="/my/apps/expenses/history" class="dt-filter-panel">
                    <input class="dt-filter-search" type="search" name="search" t-att-value="search" placeholder="Tìm theo mô tả, danh mục, người..."/>
                    <input type="hidden" name="date_from" t-att-value="date_from"/><input type="hidden" name="date_to" t-att-value="date_to"/>
                    <select name="scope"><option value="mine" t-att-selected="'selected' if scope == 'mine' else None">Của tôi</option><option value="family" t-att-selected="'selected' if scope == 'family' else None">Gia đình</option></select>
                    <select name="entry_type"><option value="">Tất cả loại</option><option value="expense" t-att-selected="'selected' if entry_type == 'expense' else None">Chi</option><option value="income" t-att-selected="'selected' if entry_type == 'income' else None">Thu</option><option value="adjustment" t-att-selected="'selected' if entry_type == 'adjustment' else None">Điều chỉnh</option><option value="debt" t-att-selected="'selected' if entry_type == 'debt' else None">Nợ</option></select>
                    <select name="wallet_id"><option value="">Tất cả nguồn tiền</option><t t-foreach="wallets" t-as="wallet"><option t-att-value="wallet.id" t-att-selected="'selected' if wallet_id == wallet.id else None"><t t-esc="wallet.name"/></option></t></select>
                    <div class="dt-filter-members" t-if="scope == 'family' and family_members and len(family_members) > 1">
                        <span class="dt-filter-members__label">Thành viên</span>
                        <div class="dt-filter-members__chips">
                            <t t-foreach="family_members" t-as="fm">
                                <label class="dt-member-chip">
                                    <input type="checkbox" name="member_ids" t-att-value="fm.id" t-att-checked="'checked' if fm.id in (selected_member_ids or []) else None"/>
                                    <span><t t-esc="fm.name"/></span>
                                </label>
                            </t>
                        </div>
                    </div>
                    <button class="dt-btn dt-btn--ghost dt-filter-submit" type="submit">Lọc</button>
                </form>
                <div class="dt-history-list" data-entry-list="1">
                    <t t-call="dt_expense.portal_expense_history_entries_partial"/>
                </div>
                <div t-if="has_more" data-scroll-sentinel="1" data-has-more="1" t-att-data-next-offset="next_offset" t-att-data-scope="scope" t-att-data-search="search" t-att-data-member-id="member_id or ''" t-att-data-member-ids="','.join(str(i) for i in (selected_member_ids or []))" t-att-data-date-from="date_from" t-att-data-date-to="date_to" t-att-data-entry-type="entry_type" t-att-data-parent-id="parent_id or ''" t-att-data-category-id="category_id or ''" t-att-data-wallet-id="wallet_id or ''"></div>
                <div class="dt-empty-state d-none" data-scroll-loading="1">Đang tải thêm...</div>
            </section>
        </t>
    </template>

    <template id="portal_expense_report" name="Expense Report">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page">
                <div class="dt-screen-head"><h1>Báo cáo chi tiêu</h1><p>Phân bổ theo danh mục · <t t-esc="period_label"/></p></div>
                <div class="dt-chip-tabs"><a t-attf-class="#{'is-active' if period == 'week' else ''}" href="/my/apps/expenses/reports?period=week">Tuần</a><a t-attf-class="#{'is-active' if period == 'month' else ''}" href="/my/apps/expenses/reports?period=month">Tháng</a><a t-attf-class="#{'is-active' if period == 'quarter' else ''}" href="/my/apps/expenses/reports?period=quarter">Quý</a><a t-attf-class="#{'is-active' if period == 'year' else ''}" href="/my/apps/expenses/reports?period=year">Năm</a></div>
                <div class="dt-report-donut-card"><div class="dt-donut" t-att-style="report['pie_style']"><span><small>Tổng chi</small><strong><t t-esc="expense_total_label"/></strong></span></div></div>
                <div class="dt-report-detail"><h2>Chi tiết theo danh mục</h2><t t-if="report['rows']"><t t-foreach="report['rows']" t-as="row"><div class="dt-report-detail-row"><span class="dt-category-icon"><t t-esc="row['icon']"/></span><div><h3><t t-esc="row['name']"/></h3><p><t t-esc="row['ratio']"/>% · <t t-esc="row['amount_label']"/></p><div class="dt-bar"><i t-att-style="'width:' + str(row['ratio_raw']) + '%;background:' + str(row['color']) + ';'"></i></div></div><strong><t t-esc="row['ratio']"/>%</strong></div></t></t><t t-else=""><div class="dt-empty-state">Chưa có chi tiêu trong kỳ này.</div></t></div>
            </section>
        </t>
    </template>

    <template id="portal_expense_suggestions" name="Expense Suggestions">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page"><div class="dt-screen-head dt-row-between"><div><h1>Gợi ý tiêu đề</h1><p><t t-esc="category.name"/></p></div><a t-att-href="'/my/apps/expenses/categories/%s/suggestions/new' % category.id" class="dt-round-btn">+</a></div><div class="dt-list-stack"><t t-foreach="suggestions" t-as="suggestion"><div class="dt-wallet-card"><div><strong><t t-esc="suggestion.name"/></strong><p>Thứ tự <t t-esc="suggestion.sequence"/></p></div><a t-att-href="'/my/apps/expenses/suggestions/%s/edit' % suggestion.id">Sửa</a></div></t></div></section>
        </t>
    </template>

    <template id="portal_expense_suggestion_form" name="Expense Suggestion Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page"><form t-att-action="'/my/apps/expenses/categories/%s/suggestions/save' % category.id" method="post" class="dt-panel dt-form-stack"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input t-if="suggestion" type="hidden" name="suggestion_id" t-att-value="suggestion.id"/><label class="dt-field"><span>Tiêu đề gợi ý</span><input type="text" name="name" t-att-value="suggestion.name if suggestion else ''" required="required"/></label><label class="dt-field"><span>Thứ tự</span><input type="number" name="sequence" t-att-value="suggestion.sequence if suggestion else 10"/></label><button type="submit" class="dt-btn dt-btn--primary">Lưu gợi ý</button></form></section>
        </t>
    </template>
</odoo>
