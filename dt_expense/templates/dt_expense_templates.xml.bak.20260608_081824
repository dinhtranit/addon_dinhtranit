            <section class="dt-expense-page">
                <div class="dt-screen-head"><h1>Báo cáo chi tiêu</h1><p>Phân bổ theo danh mục · <t t-esc="period_label"/></p></div>
                <div class="dt-chip-tabs"><a t-attf-class="#{'is-active' if period == 'week' else ''}" href="/my/apps/expenses/reports?period=week">Tuần</a><a t-attf-class="#{'is-active' if period == 'month' else ''}" href="/my/apps/expenses/reports?period=month">Tháng</a><a t-attf-class="#{'is-active' if period == 'quarter' else ''}" href="/my/apps/expenses/reports?period=quarter">Quý</a><a t-attf-class="#{'is-active' if period == 'year' else ''}" href="/my/apps/expenses/reports?period=year">Năm</a></div>
                <div class="dt-report-donut-card"><div class="dt-donut" t-att-style="report['pie_style']"><span><small>Tổng chi</small><strong><t t-esc="expense_total_label"/></strong></span></div></div>
                <div class="dt-report-detail"><h2>Chi tiết theo danh mục</h2><t t-if="report['rows']"><t t-foreach="report['rows']" t-as="row"><a t-attf-href="/my/apps/expenses/history?#{'parent_id' if group_mode == 'parent' else 'category_id'}=#{row['id']}&amp;date_from=#{report['filter_date_from']}&amp;date_to=#{report['filter_date_to']}&amp;entry_type=expense&amp;scope=#{scope}" class="dt-report-detail-row"><span class="dt-category-icon"><t t-esc="row['icon']"/></span><div><h3><t t-esc="row['name']"/></h3><p><t t-esc="row['ratio']"/>% · <t t-esc="row['amount_label']"/></p><div class="dt-bar"><i t-att-style="'width:' + str(row['ratio_raw']) + '%;background:' + str(row['color']) + ';'"></i></div></div><strong><t t-esc="row['ratio']"/>%</strong></a></t></t><t t-else=""><div class="dt-empty-state">Chưa có chi tiêu trong kỳ này.</div></t></div>
            </section>
        </t>
    </template>

    <template id="portal_expense_suggestions" name="Expense Suggestions">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page"><div class="dt-screen-head dt-row-between"><div><h1>Gợi ý tiêu đề</h1><p><t t-esc="category.name"/></p></div><a t-att-href="'/my/apps/expenses/categories/%s/suggestions/new' % category.id" class="dt-round-btn">+</a></div><div class="dt-list-stack"><t t-foreach="suggestions" t-as="suggestion"><div class="dt-wallet-card"><div><strong><t t-esc="suggestion.name"/></strong><p>Thứ tự <t t-esc="suggestion.sequence"/></p></div><a t-att-href="'/my/apps/expenses/suggestions/%s/edit' % suggestion.id">Sửa</a></div></t></div></section>
        </t>
    </template>

    <template id="portal_expense_suggestion_form" name="Expense Suggestion Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-expense-page"><form t-att-action="'/my/apps/expenses/categories/%s/suggestions/save' % category.id" method="post" class="dt-panel dt-form-stack"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input t-if="suggestion" type="hidden" name="suggestion_id" t-att-value="suggestion.id"/><label class="dt-field"><span>Tiêu đề gợi ý</span><input type="text" name="name" t-att-value="suggestion.name if suggestion else ''" required="required"/></label><label class="dt-field"><span>Thứ tự</span><input type="number" name="sequence" t-att-value="suggestion.sequence if suggestion else 10"/></label><button type="submit" class="dt-btn dt-btn--primary">Lưu gợi ý</button></form></section>
        </t>
    </template>
</odoo>
