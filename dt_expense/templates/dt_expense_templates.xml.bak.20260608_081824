                                <div class="dt-debt-card__meta"><t t-esc="debt.debt_date.strftime('%d/%m/%Y') if debt.debt_date else ''"/> · Gốc <t t-esc="request.env['dt.expense.entry']._format_money(debt.amount)"/> · Đã trả <t t-esc="request.env['dt.expense.entry']._format_money(debt.paid_amount)"/></div>
