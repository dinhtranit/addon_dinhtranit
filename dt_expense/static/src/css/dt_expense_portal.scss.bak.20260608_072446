.dt-date-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.4); cursor: pointer; }
.dt-date-modal__sheet { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%); width: 100%; max-width: 480px; background: #faf3e8; border-radius: 24px 24px 0 0; display: flex; flex-direction: column; padding-bottom: 8px; }
.dt-date-modal__head { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px 8px; }
.dt-date-modal__head strong { font-size: 18px; font-weight: 900; }
.dt-date-modal__close { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: #fff; border: 1px solid var(--dt-line); color: var(--dt-muted); cursor: pointer; padding: 0; }
.dt-date-modal__tabs { display: flex; gap: 6px; padding: 0 18px 10px; }
.dt-date-modal__tabs button { flex: 1 1 0; padding: 8px 12px; border: 1px solid var(--dt-line); background: #fff; border-radius: 999px; font-weight: 700; font-size: 13px; cursor: pointer; color: var(--dt-text); }
.dt-date-modal__tabs button.is-active { background: var(--dt-primary); color: #fff; border-color: var(--dt-primary); }
.dt-date-modal__panel { padding: 4px 18px 12px; }
.dt-date-modal__panel.d-none { display: none; }
.dt-date-modal__panel label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 700; color: var(--dt-muted); }
.dt-date-modal__panel input { padding: 10px 12px; border: 1px solid var(--dt-line); background: #fff; border-radius: 12px; font-size: 16px; }
.dt-date-modal__footer { display: flex; gap: 10px; padding: 6px 18px 16px; justify-content: flex-end; }

.dt-cat-filter-trigger { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: #fff; border: 1px solid var(--dt-line); border-radius: 14px; cursor: pointer; width: 100%; text-align: left; }
.dt-cat-filter-trigger__icon { font-size: 18px; }
.dt-cat-filter-trigger__label { flex: 1 1 auto; font-weight: 700; color: var(--dt-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dt-cat-filter-trigger__caret { color: var(--dt-muted); font-size: 12px; }
[data-filter-cat-modal="1"] .dt-cat-modal__sheet { position: absolute; inset: 0; background: #faf3e8; }
.dt-cat-group__head--btn { display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 16px; background: #fff4e6; border: 0; cursor: pointer; text-align: left; }
.dt-cat-group__head--btn:hover { background: #ffe9c8; }
.dt-cat-group__pick { margin-left: auto; font-size: 11px; font-weight: 700; color: var(--dt-primary-dark); text-transform: uppercase; letter-spacing: .3px; }
.dt-cat-group--income .dt-cat-group__head--btn { background: #e8f7ec; }
.dt-cat-group--income .dt-cat-group__head--btn:hover { background: #d3f0db; }
.dt-cat-group--income .dt-cat-group__pick { color: var(--dt-primary); }
.dt-month-card--nav > a { width: 36px; height: 36px; font-size: 22px; border-radius: 10px; }
.dt-month-card__label { text-align: center; font-size: 14px; }
.dt-month-card__label strong { font-weight: 800; }
.dt-history-page { gap: 12px; }
.dt-history-summary { font-size: 13px; font-weight: 700; color: var(--dt-muted); padding: 4px 4px 0; }

.dt-month-totals-card {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid var(--dt-line);
    border-radius: 20px;
    text-align: center;
}
.dt-month-totals-card > div { display: flex; flex-direction: column; gap: 4px; }
.dt-month-totals-card span { font-size: 12px; color: var(--dt-muted); font-weight: 700; text-transform: uppercase; letter-spacing: .3px; }
.dt-month-totals-card b { font-size: 14px; font-weight: 800; }
.dt-month-totals-card--4col { grid-template-columns: repeat(4, 1fr); }
.dt-month-totals-card--4col b { font-size: 13px; }

.dt-filter-topbar { display: grid; grid-template-columns: 1fr auto; gap: 8px; grid-column: 1 / -1; align-items: center; }
.dt-filter-toggle-wrap { display: inline-flex; align-items: center; gap: 6px; }
.dt-filter-icon-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; background: #fff; border: 1px solid var(--dt-line); color: var(--dt-text); cursor: pointer; padding: 0; }
.dt-filter-icon-btn:hover { background: var(--dt-accent-soft); border-color: var(--dt-primary); color: var(--dt-primary); }
.dt-filter-badge { position: absolute; top: -4px; right: -4px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background: var(--dt-primary); color: #fff; font-size: 10px; font-weight: 800; line-height: 16px; text-align: center; box-shadow: 0 1px 3px rgba(0,0,0,.15); }
.dt-filter-clear { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: #fff; border: 1px solid var(--dt-line); color: var(--dt-muted); text-decoration: none; }
.dt-filter-clear:hover { background: #ffe8e0; color: var(--dt-accent); border-color: var(--dt-accent); }

.dt-history-edit { position: absolute; bottom: 8px; right: 10px; z-index: 3; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: #fff; border: 1px solid var(--dt-line); color: var(--dt-muted); text-decoration: none; }
.dt-history-edit:hover { background: var(--dt-accent-soft); color: var(--dt-primary); border-color: var(--dt-primary); }

.dt-delete-form { margin-top: 12px; display: flex; justify-content: center; }
.dt-btn--danger-ghost { background: transparent; border: 1px solid #e8b4a8; color: #b14b3a; padding: 8px 16px; border-radius: 14px; font-weight: 700; cursor: pointer; }
.dt-btn--danger-ghost:hover { background: #fbeae5; }
.dt-filter-advanced { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; grid-column: 1 / -1; }
.dt-filter-advanced.d-none { display: none; }
@media (max-width: 600px) { .dt-filter-advanced { grid-template-columns: 1fr; } }

.dt-member-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 10px;
    min-height: 40px;
    width: 100%;
    background: #fff;
    border: 1px solid var(--dt-line);
    border-radius: 14px;
    cursor: pointer;
}
.dt-member-trigger__avatars { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
.dt-member-trigger__placeholder { color: var(--dt-muted); font-weight: 700; font-size: 13px; }
.dt-member-trigger__caret { color: var(--dt-muted); font-size: 12px; }
.dt-member-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--dt-line);
}

.dt-member-modal { position: fixed; inset: 0; z-index: 1000; display: flex; flex-direction: column; justify-content: flex-end; }
.dt-member-modal.d-none { display: none; }
.dt-member-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.4); cursor: pointer; }
.dt-member-modal__sheet { position: relative; display: flex; flex-direction: column; max-height: 80vh; background: #faf3e8; border-radius: 24px 24px 0 0; box-shadow: 0 -8px 30px rgba(0,0,0,.2); }
.dt-member-modal__head { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px 10px; }
.dt-member-modal__head strong { font-size: 18px; font-weight: 900; }
.dt-member-modal__close { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: #fff; border: 1px solid var(--dt-line); color: var(--dt-muted); cursor: pointer; padding: 0; }
.dt-member-modal__close:hover { background: var(--dt-accent-soft); color: var(--dt-primary); border-color: var(--dt-primary); }
.dt-member-modal__list { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 6px 14px; }
.dt-member-modal .dt-member-row { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: center; padding: 12px 14px; background: #fff; border: 1px solid var(--dt-line); border-radius: 16px; margin-bottom: 8px; cursor: pointer; }
.dt-member-modal .dt-member-row:hover { background: var(--dt-accent-soft); border-color: var(--dt-primary); }
.dt-member-modal .dt-member-row:has(input:checked) { background: var(--dt-accent-soft); border-color: var(--dt-primary); }
.dt-member-modal .dt-member-row__name { font-weight: 800; font-size: 15px; }
.dt-member-modal .dt-member-row input[type="checkbox"] { width: 22px; height: 22px; accent-color: var(--dt-primary); cursor: pointer; }
.dt-member-avatar--lg { width: 44px; height: 44px; }
.dt-member-modal__footer { display: flex; gap: 10px; padding: 12px 18px 18px; justify-content: flex-end; }
.dt-member-modal__footer .dt-btn { padding: 10px 22px; }

.dt-history-row { position: relative; }
.dt-history-rowlink { position: absolute; inset: 0; z-index: 1; }
.dt-history-main, .dt-history-icon, .dt-history-amount { position: relative; z-index: 0; }
.dt-history-actions { position: relative; z-index: 2; }
.dt-history-amount { font-size: 15px; font-weight: 800; }
.dt-history-row .dt-history-main h3 { font-size: 16px; }
.dt-history-row .dt-history-main p { font-size: 12px; }

.dt-filter-panel {
    display: grid;
    grid-template-columns: 1fr 130px;
    gap: 8px;
    padding: 10px;
    min-width: 0;
}

.dt-filter-panel > * { min-width: 0; max-width: 100%; }
.dt-filter-panel input,
.dt-filter-panel select,
.dt-filter-panel button { box-sizing: border-box; }

.dt-filter-members {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 6px 4px 2px;
}
.dt-filter-members__label {
    font-size: 13px;
    font-weight: 800;
    color: var(--dt-muted);
    text-transform: uppercase;
    letter-spacing: .3px;
}
.dt-filter-members__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.dt-member-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--dt-line);
    background: #fff;
    cursor: pointer;
    font-weight: 700;
    font-size: 14px;
    user-select: none;
    max-width: 100%;
}
.dt-member-chip input { margin: 0; accent-color: var(--dt-primary); }
.dt-member-chip span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 160px;
}
.dt-member-chip:has(input:checked) {
    background: var(--dt-accent-soft);
    border-color: var(--dt-primary);
    color: var(--dt-primary-dark);
}

.dt-history-list {
    display: grid;
    border: 1px solid var(--dt-line);
    border-radius: 28px;
    overflow: hidden;
    background: #fff;
}

.dt-history-row {
    padding: 16px;
    border-bottom: 1px solid var(--dt-line);
}

.dt-history-row:last-child {
    border-bottom: 0;
}

.dt-history-main h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 900;
}

.dt-report-donut-card {
    padding: 20px;
}

.dt-report-detail {
    display: grid;
    gap: 12px;
}

.dt-report-detail-row {
    grid-template-columns: auto 1fr auto;
    padding: 14px 0;
    border-bottom: 1px solid var(--dt-line);
}

.dt-report-detail-row:last-child {
    border-bottom: 0;
}

.dt-report-detail-row h3 {
    margin: 0;
    font-size: 16px;
}

a.dt-report-detail-row, a.dt-report-line { color: var(--dt-text); text-decoration: none; cursor: pointer; }
a.dt-report-detail-row:hover, a.dt-report-line:hover { background: var(--dt-accent-soft); border-radius: 12px; }

@media (max-width: 768px) {
    .dt-filter-panel { grid-template-columns: 1fr; }
    .dt-month-totals { grid-template-columns: 1fr; }
}

@media (max-width: 430px) {
    .dt-home-hero h1,
    .dt-screen-head h1 { font-size: 37px; }
    .dt-balance-big { font-size: 54px; }
    .dt-shortcut-panel { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .dt-shortcut span { width: 52px; height: 52px; }
    .dt-shortcut strong { font-size: 14px; }
    .dt-report-preview { grid-template-columns: 1fr; }
    .dt-donut-small { margin: 0 auto; }
    .dt-child-grid { grid-template-columns: repeat(3, 1fr); }
    .dt-line-field { grid-template-columns: 120px 1fr; }
    .dt-filter-panel { grid-template-columns: 1fr; }
    .dt-mini-payment { grid-template-columns: 1fr; }
}
.dt-history-icon--media {
    overflow: hidden;
}
.dt-history-icon--media img,
.dt-history-icon--media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Report section labels */
.dt-report-section-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--dt-text-muted, #888);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 16px 0 8px 0;
    &--income { color: var(--dt-income, #5a8f5a); }
}
.dt-donut--income::after { background: var(--dt-bg-card, #fff); }
.dt-report-line--income .dt-bar i { background: var(--dt-income, #5a8f5a) !important; }

.dt-save-bar.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(16px);
    transition: opacity .15s ease, transform .15s ease;
}

/* Debt form */
.dt-debt-form-page .dt-save-bar { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 70; }
.dt-debt-form-page { padding-bottom: 100px; }

.dt-counterparty-wrap { position: relative; flex: 1; }
.dt-counterparty-wrap input { width: 100%; border: none; background: transparent; font-size: 15px; font-weight: 600; outline: none; text-align: right; color: var(--dt-text); }
.dt-counterparty-wrap .dt-autocomplete-list { position: absolute; right: 0; left: 0; top: calc(100% + 4px); z-index: 50; margin-top: 0; }

.dt-debt-date-row { display: flex; gap: 12px; flex: 1; justify-content: flex-end; }
.dt-debt-date-item { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
.dt-debt-date-item small { font-size: 11px; color: var(--dt-muted); font-weight: 700; text-transform: uppercase; }
.dt-debt-date-item input[type="date"] { border: none; background: transparent; font-size: 14px; font-weight: 700; color: var(--dt-text); text-align: right; outline: none; padding: 0; }

/* Debt info panel — icon-only label, narrow column */
.dt-debt-info-panel .dt-line-field {
    grid-template-columns: 36px 1fr;
    gap: 10px;
    overflow: visible;
}
.dt-debt-info-panel .dt-line-field > span {
    font-size: 20px;
    text-align: center;
}
.dt-debt-info-panel select,
.dt-debt-info-panel input[type="text"],
.dt-debt-info-panel input[type="date"] {
    min-width: 0;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.dt-date-value {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    min-width: 0;
}
.dt-date-value small {
    font-size: 11px;
    color: var(--dt-muted);
    font-weight: 700;
    text-transform: uppercase;
}
.dt-date-value input[type="date"] {
    font-size: 15px;
    font-weight: 700;
    text-align: right;
    border: none;
    background: transparent;
    padding: 0;
    outline: none;
    width: auto;
    max-width: 100%;
}
/* Counterparty autocomplete z-index fix */
.dt-debt-info-panel { overflow: visible !important; }
.dt-counterparty-wrap .dt-autocomplete-list {
    z-index: 100;
    min-width: 200px;
}

/* Contact dropdown (inline) */
.dt-contact-dropdown {
    position: absolute;
    left: 0; right: 0;
    top: calc(100% + 4px);
    z-index: 100;
    background: #fff;
    border: 1px solid var(--dt-line);
    border-radius: 14px;
    box-shadow: 0 6px 24px rgba(0,0,0,.10);
    overflow: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity .15s ease, transform .15s ease;
    pointer-events: none;
    &.is-open { opacity: 1; transform: translateY(0); pointer-events: auto; }
}
.dt-contact-results {
    max-height: 200px;
    overflow-y: auto;
}
.dt-contact-more {
    display: block;
    width: 100%;
    border: none;
    border-top: 1px solid var(--dt-line);
    background: var(--dt-accent-soft);
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 700;
    color: var(--dt-primary);
    text-align: center;
    cursor: pointer;
}

/* Contact full-screen modal */
.dt-contact-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--dt-bg);
    display: flex;
    flex-direction: column;
}
.dt-contact-modal__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px 8px;
    background: rgba(255,248,240,.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--dt-line);
    strong { flex: 1; text-align: center; font-size: 17px; font-weight: 900; }
}
.dt-contact-new-btn {
    border: none;
    background: none;
    color: var(--dt-primary);
    font-weight: 900;
    font-size: 15px;
    cursor: pointer;
    padding: 8px 0;
}
.dt-contact-modal__search {
    padding: 12px 16px;
    border-bottom: 1px solid var(--dt-line);
    .dt-cat-search { margin: 0; }
}
.dt-contact-modal__list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0;
}
.dt-contact-modal__item {
    display: flex;
    flex-direction: column;
    padding: 14px 20px;
    border-bottom: 1px solid var(--dt-line);
    cursor: pointer;
    background: transparent;
    border-left: none;
    border-right: none;
    border-top: none;
    text-align: left;
    width: 100%;
    strong { font-size: 16px; font-weight: 700; color: var(--dt-text); }
    small { font-size: 13px; color: var(--dt-muted); margin-top: 2px; }
    &:active { background: var(--dt-accent-soft); }
}
.dt-contact-new-form {
    padding: 16px;
    border-top: 1px solid var(--dt-line);
    background: #fff;
}
.dt-contact-new-form__inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    strong { font-size: 15px; font-weight: 900; }
}
.dt-contact-new-actions {
    display: flex;
    gap: 10px;
    .dt-btn { flex: 1; }
}
