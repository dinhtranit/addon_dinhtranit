<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_shell" name="Family Portal Shell">
        <t t-call="website.layout">
            <t t-set="no_footer" t-value="1"/>
            <div class="dt-shell" t-att-data-page="page_name or 'expenses'">
                <header class="dt-topbar">
                    <a t-if="back_url" t-att-href="back_url" class="dt-back-btn" aria-label="Quay lại">‹</a>
                    <div class="dt-topbar__center">
                        <div class="dt-page-title"><t t-esc="page_title or 'Family'"/></div>
                        <div t-if="page_subtitle" class="dt-page-subtitle"><t t-esc="page_subtitle"/></div>
                    </div>
                    <div class="dt-topbar__actions">
                        <button t-if="show_balance_toggle" type="button" class="dt-eye-toggle" data-balance-toggle="1" t-att-aria-label="'Ẩn số tiền' if balance_visible else 'Hiện số tiền'" t-att-title="'Ẩn số tiền' if balance_visible else 'Hiện số tiền'"><t t-if="balance_visible">🙈</t><t t-else="">👁</t></button>
                        <a t-if="page_action_url" t-att-href="page_action_url" class="dt-round-btn dt-round-btn--green" aria-label="Thêm mới">+</a>
                    </div>
                </header>
                <main class="dt-main-content"><t t-out="0"/></main>
                <nav t-if="show_bottom_nav" class="dt-bottom-nav">
                    <a href="/my/apps/expenses" t-attf-class="dt-bottom-nav__item #{'is-active' if page_name == 'expenses' else ''}"><span>💰</span><small>Tài chính</small></a>
                    <a href="/my/apps/memories" t-attf-class="dt-bottom-nav__item #{'is-active' if page_name == 'memories' else ''}"><span>📸</span><small>Kỷ niệm</small></a>
                    <a href="/my/profile" t-attf-class="dt-bottom-nav__item #{'is-active' if page_name == 'profile' else ''}"><span>👤</span><small>Tôi</small></a>
                </nav>
            </div>
        </t>
    </template>

    <template id="portal_profile" name="Family Profile">
        <t t-call="dt_core.portal_shell">
            <section class="dt-profile-page pb-4">
                <div class="dt-profile-hero">
                    <img t-attf-src="/web/image/res.partner/#{profile_partner.id}/avatar_128" alt="avatar" class="dt-profile-card__avatar"/>
                    <h1><t t-esc="profile_partner.name"/></h1>
                    <p><t t-esc="profile_partner.dt_bio or 'Quản trị viên gia đình'"/></p>
                </div>

                <form action="/my/profile/save" method="post" enctype="multipart/form-data" class="dt-form-stack">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="dt-profile-card">
                        <div class="dt-section-title">Hồ sơ của tôi</div>
                        <label class="dt-field"><span>Đổi ảnh đại diện</span><input type="file" name="avatar_file" accept="image/*"/><div class="dt-file-help">Avatar mới sẽ hiển thị ở toàn bộ app.</div></label>
                        <label class="dt-field"><span>Họ tên</span><input type="text" name="name" t-att-value="profile_partner.name or ''" required="required"/></label>
                        <label class="dt-field"><span>Số điện thoại</span><input type="text" name="phone" t-att-value="profile_partner.phone or ''"/></label>
                        <label class="dt-field"><span>Giới thiệu ngắn</span><textarea name="bio" rows="3"><t t-esc="profile_partner.dt_bio or ''"/></textarea></label>
                    </div>

                    <div class="dt-profile-card">
                        <div class="dt-row-between dt-profile-section-head">
                            <div>
                                <div class="dt-section-title">Gia đình của tôi</div>
                                <div class="dt-entry-note">Bật riêng quyền xem tài chính và quyền xem kỷ niệm cho từng user thật trong Odoo.</div>
                            </div>
                        </div>
                        <div class="dt-family-list">
                            <div class="dt-family-member-row">
                                <img t-attf-src="/web/image/res.partner/#{profile_partner.id}/avatar_128"/>
                                <div><strong><t t-esc="profile_partner.name"/></strong><p>Toàn quyền · Bạn</p></div>
                                <span class="dt-owner-pill">Bạn</span>
                            </div>
                            <t t-if="family_users">
                                <t t-foreach="family_users" t-as="member">
                                    <t t-set="member_access" t-value="access_map.get(member.id)"/>
                                    <div class="dt-family-member-row">
                                        <img t-attf-src="/web/image/res.partner/#{member.partner_id.id}/avatar_128"/>
                                        <div><strong><t t-esc="member.name"/></strong><p><t t-esc="member.login or ''"/></p></div>
                                        <div class="dt-access-toggles">
                                            <label>Thu chi <input type="checkbox" t-att-name="'family_expense_%s' % member.id" t-att-checked="'checked' if member_access and member_access.allow_expense else None"/></label>
                                            <label>Kỷ niệm <input type="checkbox" t-att-name="'family_memory_%s' % member.id" t-att-checked="'checked' if member_access and member_access.allow_memory else None"/></label>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else=""><div class="dt-empty-state">Chưa có user nội bộ khác để cấu hình gia đình.</div></t>
                        </div>
                    </div>

                    <div class="dt-profile-card dt-settings-list">
                        <a href="/my/apps/expenses/debts"><span>🤝</span><div><strong>Sổ nợ</strong><small>Cho mượn và mình mượn</small></div><b>›</b></a>
                        <a href="/my/apps/expenses/wallets"><span>💳</span><div><strong>Nguồn tiền</strong><small>Momo, ngân hàng, tiền mặt</small></div><b>›</b></a>
                        <a href="/my/apps/expenses/categories"><span>🗂️</span><div><strong>Danh mục</strong><small>Nhóm cha và mục con</small></div><b>›</b></a>
                        <a href="/my/apps/expenses/plans"><span>🎯</span><div><strong>Kế hoạch</strong><small>Mua xe, mua nhà, con cái...</small></div><b>›</b></a>
                    </div>

                    <div class="dt-action-stack">
                        <button type="submit" class="dt-btn dt-btn--primary">Lưu thông tin</button>
                        <a href="/my/profile/logout" class="dt-btn dt-btn--ghost">Đăng xuất</a>
                    </div>
                </form>
            </section>
        </t>
    </template>
</odoo>
