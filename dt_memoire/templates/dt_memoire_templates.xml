<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_memories_feed" name="Family Memories Feed">
        <t t-call="dt_core.portal_shell">
            <section class="dt-memory-page">
                <div class="dt-memory-titlebar">
                    <div>
                        <div class="dt-memory-kicker">Nhật ký gia đình</div>
                        <!-- <h1>Mái ấm <em>của mình</em></h1> -->
                    </div>
                    <a href="/my/apps/memories/new" class="dt-memory-add">+</a>
                </div>
                <form method="get" action="/my/apps/memories" class="dt-memory-filters">
                    <a t-attf-class="#{'is-active' if not mine and not category else ''}" href="/my/apps/memories">Tất cả · <t t-esc="total"/></a>
                    <a t-attf-class="#{'is-active' if mine else ''}" href="/my/apps/memories?mine=1">Của tôi</a>
                    <t t-foreach="categories[:4]" t-as="cat">
                        <a t-attf-class="#{'is-active' if category == cat[0] else ''}" t-att-href="'/my/apps/memories?category=%s' % cat[0]"><t t-esc="cat[1]"/></a>
                    </t>
                </form>
                <div class="dt-memory-month">Tháng này · <t t-esc="total"/> kỷ niệm</div>
                <t t-if="diaries">
                    <div class="dt-memory-grid">
                        <t t-foreach="diaries" t-as="diary">
                            <a t-att-href="'/my/apps/memories/%s' % diary.id" t-attf-class="dt-memory-card #{'dt-memory-card--wide' if diary_index == 0 else ''}">
                                <div class="dt-memory-cover">
                                    <t t-if="diary.cover_media_id and diary.cover_media_id.media_type == 'image'"><img t-att-src="diary.cover_media_id.image_url()" alt="cover"/></t>
                                    <t t-elif="diary.cover_media_id and diary.cover_media_id.media_type == 'video'"><video muted="muted" playsinline="playsinline" preload="metadata" t-att-src="diary.cover_media_id.stream_url()"></video></t>
                                    <t t-else=""><span><t t-esc="diary.get_emotion_icon()"/></span></t>
                                    <div class="dt-memory-people"><span><t t-esc="(diary.user_id.name or '?')[:1]"/></span></div>
                                </div>
                                <div class="dt-memory-body">
                                    <h2><t t-esc="diary.title"/></h2>
                                    <p>📅 <t t-esc="diary.memory_date.strftime('%d/%m') if diary.memory_date else ''"/> · <t t-if="diary.location">📍 <t t-esc="diary.location"/> · </t><t t-esc="diary.get_emotion_icon()"/></p>
                                </div>
                            </a>
                        </t>
                    </div>
                </t>
                <t t-else=""><div class="dt-empty-state">Chưa có kỷ niệm phù hợp.</div></t>
                <t t-if="pager and pager.get('page_count', 0) &gt; 1"><div class="o_portal_pager"><t t-call="portal.portal_pager"/></div></t>
            </section>
        </t>
    </template>

    <template id="portal_memory_detail" name="Family Memory Detail">
        <t t-call="dt_core.portal_shell">
            <section class="dt-memory-page pb-4">
                <div class="dt-memory-detail-card">
                    <t t-set="cover" t-value="diary.cover_media_id"/>
                    <div class="dt-memory-detail-cover" t-if="cover">
                        <img t-if="cover.media_type == 'image'" t-att-src="cover.image_url()"/>
                        <video t-if="cover.media_type == 'video'" t-att-src="cover.stream_url()" controls="controls" playsinline="playsinline"></video>
                    </div>
                    <div class="dt-memory-detail-body">
                        <h1><t t-esc="diary.title"/></h1>
                        <p>📅 <t t-esc="diary.memory_date.strftime('%d/%m/%Y') if diary.memory_date else ''"/> · 👤 <t t-esc="diary.user_id.name"/> <t t-if="diary.location">· 📍 <t t-esc="diary.location"/></t></p>
                        <div class="dt-memory-badges"><span><t t-esc="diary.get_emotion_icon()"/> <t t-esc="dict(diary._fields['emotion'].selection).get(diary.emotion, '')"/></span><span><t t-esc="dict(diary._fields['category'].selection).get(diary.category, '')"/></span><span t-if="diary.privacy == 'private'">🔒 Chỉ mình tôi</span></div>
                        <div t-if="diary.story" class="dt-memory-story"><t t-raw="diary.story"/></div>
                    </div>
                </div>
                <t t-set="media_items" t-value="diary.get_media_items()"/>
                <div class="dt-memory-media" t-if="media_items">
                    <t t-foreach="media_items" t-as="media">
                        <div class="dt-media-tile">
                            <img t-if="media.media_type == 'image'" t-att-src="media.image_url()"/>
                            <video t-if="media.media_type == 'video'" t-att-src="media.stream_url()" controls="controls" preload="metadata" playsinline="playsinline"></video>
                        </div>
                    </t>
                </div>
                <div t-if="diary.user_id.id == request.env.user.id" class="dt-inline-actions">
                    <a t-att-href="'/my/apps/memories/%s/edit' % diary.id" class="dt-btn dt-btn--secondary">Sửa kỷ niệm</a>
                    <form t-att-action="'/my/apps/memories/%s/delete' % diary.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="dt-btn dt-btn--ghost">Xóa</button></form>
                </div>
            </section>
        </t>
    </template>

    <template id="portal_memory_form" name="Family Memory Form">
        <t t-call="dt_core.portal_shell">
            <section class="dt-memory-page">
                <form action="/my/apps/memories/save" method="post" enctype="multipart/form-data" class="dt-memory-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="diary" type="hidden" name="diary_id" t-att-value="diary.id"/>
                    <div class="dt-screen-head"><h1>Tạo kỷ niệm</h1><p>Ghi lại một khoảnh khắc</p></div>
                    <div class="dt-memory-upload-box">
                        <div class="dt-block-title">Ảnh &amp; video</div>
                        <input class="dt-file-input" type="file" name="media_files" multiple="multiple" accept="image/*,video/*" data-file-input="1" data-upload-model="dt.memoire.diary"/><span class="dt-file-button">Tải file</span>
                        <div class="dt-upload-preview" t-if="diary and diary.get_media_items()">
                            <t t-foreach="diary.get_media_items()" t-as="media">
                                <div class="dt-upload-thumb"><img t-if="media.media_type == 'image'" t-att-src="media.image_url()"/><video t-if="media.media_type == 'video'" t-att-src="media.stream_url()" preload="metadata"></video></div>
                            </t>
                        </div>
                    </div>
                    <div class="dt-info-panel">
                        <label class="dt-line-field"><span>Tiêu đề</span><input type="text" name="title" required="required" t-att-value="diary.title if diary else ''" placeholder="Sinh nhật bé Bin 6 tuổi"/></label>
                        <label class="dt-line-field"><span>Cảm xúc</span><select name="emotion"><t t-foreach="request.env['dt.memoire.diary']._fields['emotion'].selection" t-as="emotion_item"><option t-att-value="emotion_item[0]" t-att-selected="'selected' if diary and diary.emotion == emotion_item[0] else ('selected' if (not diary and emotion_item[0] == 'joyful') else None)"><t t-esc="emotion_item[1]"/></option></t></select></label>
                        <label class="dt-line-field"><span>Ngày</span><input type="date" name="memory_date" t-att-value="default_date"/></label>
                        <label class="dt-line-field"><span>Địa điểm</span><input type="text" name="location" t-att-value="diary.location if diary else ''" placeholder="Ở nhà · Phòng khách"/></label>
                        <label class="dt-line-field"><span>Danh mục</span><select name="category"><t t-foreach="request.env['dt.memoire.diary']._fields['category'].selection" t-as="category_item"><option t-att-value="category_item[0]" t-att-selected="'selected' if diary and diary.category == category_item[0] else ('selected' if (not diary and category_item[0] == 'daily') else None)"><t t-esc="category_item[1]"/></option></t></select></label>
                        <label class="dt-line-field"><span>Album</span><select name="album_id"><option value="0">Không chọn</option><t t-foreach="albums" t-as="album"><option t-att-value="album.id" t-att-selected="'selected' if diary and diary.album_id and diary.album_id.id == album.id else None"><t t-esc="album.name"/></option></t></select></label>
                    </div>
                    <div class="dt-memory-share-card">
                        <div class="dt-block-title">Chia sẻ với</div>
                        <label class="dt-private-check"><input type="checkbox" name="private_only" t-att-checked="'checked' if diary and diary.privacy == 'private' else None"/> Chỉ mình mình thấy</label>
                        <div class="dt-share-chips" t-if="family_viewers">
                            <t t-foreach="family_viewers" t-as="viewer"><span><img t-attf-src="/web/image/res.partner/#{viewer.partner_id.id}/avatar_128"/> <t t-esc="viewer.name"/> ✓</span></t>
                        </div>
                        <p t-if="not family_viewers">Chưa bật quyền xem kỷ niệm cho thành viên nào trong màn Tôi.</p>
                    </div>
                    <label class="dt-memory-story-field"><span>Câu chuyện</span><textarea name="story" rows="6" placeholder="Viết lại điều muốn nhớ về ngày này..."><t t-esc="diary.story if diary else ''"/></textarea></label>
                    <div class="dt-save-bar"><button type="submit" class="dt-btn dt-btn--primary">Lưu kỷ niệm</button></div>
                </form>
            </section>
        </t>
    </template>
</odoo>
